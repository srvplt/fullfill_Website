---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

import appleTouchIcon from "../assets/images/apple-touch-icon.png";
import favicon96 from "../assets/images/favicon-96x96.png";
import faviconSvg from "../assets/images/favicon.svg";
import faviconIco from "../assets/images/favicon.ico";

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  author?: string;
  ogImage?: string;
  canonicalPath?: string;
}

const {
  title = "Fullfill – Your Personal Trainer for a Happier Mind",
  description = "Fullfill helps you build mental fitness, manage stress, reflect with an AI journal, and grow with practical tools for a calmer, more purposeful life.",
  keywords = "Fullfill app, wellness app, mental fitness, emotional fitness, AI journal, self reflection app, stress relief app, personal growth, mindfulness, breathing exercises, sleep meditation",
  author = "Fullfill Team",
  ogImage = "https://fullfill.me/images/og-image.jpg",
  canonicalPath = ""
} = Astro.props;

const currentPath = canonicalPath || Astro.url.pathname;
const normalizedPath = currentPath === '/' ? '' : (currentPath.endsWith('/') ? currentPath.slice(0, -1) : currentPath);
const canonicalUrl = `https://fullfill.me${normalizedPath}`;

const absoluteOgImage = ogImage.startsWith('http://') || ogImage.startsWith('https://')
  ? ogImage
  : `https://fullfill.me${ogImage.startsWith('/') ? ogImage : `/${ogImage}`}`;
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="apple-touch-icon" sizes="180x180" href={appleTouchIcon.src} />
    <link rel="icon" type="image/png" sizes="96x96" href={favicon96.src} />
    <link rel="icon" type="image/svg+xml" href={faviconSvg.src} />
    <link rel="shortcut icon" href={faviconIco.src} />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#ffffff" />

    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content={author} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="referrer" content="origin" />

    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Fullfill" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:image:secure_url" content={absoluteOgImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />
    <meta name="twitter:image:alt" content={title} />
    <meta name="twitter:url" content={canonicalUrl} />

    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-5N6BFZ8R');</script>
    <!-- End Google Tag Manager -->

    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "Fullfill",
        "url": "https://fullfill.me/",
        "logo": "https://fullfill.me/images/FinalLogoNameOnly.png",
        "sameAs": []
      }
    </script>

    <style is:inline>
      * { -webkit-tap-highlight-color: rgba(0, 0, 0, 0.1); }
    </style>
  </head>
  <body>
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-5N6BFZ8R" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
