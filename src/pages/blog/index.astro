---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import heroBg from '../../assets/images/photo-1434030216411-0b793f4b4173.jpeg';
import defaultImage from '../../assets/images/blog1.jpg';

import "../../styles/blog-index.css";

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title="Blog – Fullfill" description="insights, tips, and tools to help you reduce stress, build resilience, and grow with our community.">
  <div class="blog-page">
    <section class="blog-hero">
      <Image
        src={heroBg}
        alt="Fullfill blog hero background"
        loading="eager"
        fetchpriority="high"
        class="blog-hero__bg"
      />
      <div class="blog-hero__overlay"></div>
      <div class="blog-hero__content">
        <h1 class="blog-hero__title">fullfill blog</h1>
        <p class="blog-hero__subtitle">
          insights, tips, and tools to help you reduce stress, build resilience, and grow with our community.
        </p>
      </div>
    </section>

    <section class="blog-list-section site-container">
      <div class="blog-grid">
        {sortedPosts.map((post) => {
          const coverImage = post.data.image || defaultImage;
          const formattedDate = post.data.pubDate.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'short',
            day: 'numeric',
          });

          return (
            <a href={`/blog/${post.id}`} class="blog-card">
              <div class="blog-card__image-wrapper">
                <Image
                  src={coverImage}
                  alt={post.data.title}
                  width={900}
                  height={600}
                  class="blog-card__image"
                />
              </div>
              <div class="blog-card__content">
                <h2 class="blog-card__title">
                  {post.data.title.toLowerCase()}
                </h2>
                <div class="blog-card__meta">
                  <span class="blog-card__date">{formattedDate}</span>
                </div>
                <p class="blog-card__excerpt">
                  {post.data.description}
                </p>
              </div>
            </a>
          );
        })}
      </div>
    </section>
  </div>
</Layout>