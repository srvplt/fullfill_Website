---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Fullfill – Find Your Fire"
  description="Download the Fullfill app and start your personal growth journey."
  canonicalPath="/try/"
>

<script is:inline>
  const userAgent = navigator.userAgent;

  if (/iPad|iPhone|iPod/.test(userAgent)) {
    window.location.replace("https://apps.apple.com/app/id6757362734");
  } else if (/android/i.test(userAgent)) {
    window.location.replace("https://play.google.com/store/apps/details?id=com.mycompany.fullfill2");
  }
</script>


<section class="try-main">

  <div class="try-container">

    <div class="try-text">

      <h1>fullfill: find your fire</h1>

      <div class="btn-row">

        <a 
          class="btn" 
          href="https://apps.apple.com/app/id6757362734"
        >
          iOS
        </a>

        <a 
          class="btn" 
          href="https://play.google.com/store/apps/details?id=com.mycompany.fullfill2"
        >
          Android
        </a>

      </div>

    </div>


    <div class="qr-wrap">

      <img 
        class="qr" 
        src="/images/qr-code.png" 
        alt="Download Fullfill app QR code"
      />

    </div>


  </div>

</section>


</Layout>


<style>

.try-main {
  min-height: calc(100vh - 160px);
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #a9c9ff, #d2cdff);
  padding: 40px 20px;
  color: white;
}


.try-container {
  max-width: 900px;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 60px;
}


.try-text {
  flex: 1;
}


h1 {
  font-size: 34px;
  font-weight: 600;
  margin-bottom: 20px;
}


.btn-row {
  display: flex;
  gap: 12px;
}


.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 140px;
  padding: 12px 14px;
  background: rgba(255,255,255,0.15);
  border: 1px solid rgba(255,255,255,0.4);
  border-radius: 12px;
  color: white;
  text-decoration: none;
  font-size: 13px;
  font-weight: 500;
}


.qr-wrap {
  flex: 1;
  display: flex;
  justify-content: flex-start;
}


.qr {
  width: 220px;
  background: white;
  padding: 10px;
  border-radius: 14px;
}


@media (max-width: 768px) {

  .try-container {
    flex-direction: column;
    text-align: center;
  }


  .btn-row {
    justify-content: center;
  }


  .qr-wrap {
    justify-content: center;
  }


  h1 {
    font-size: 28px;
  }

}

</style>
