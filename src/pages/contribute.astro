---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Be a Contributor – Fullfill">
  <section class="contribute-section">
    <div class="container">
      <h1>Be a Contributor</h1>
      
      <p class="intro-text">Join our mission to help people discover clarity, purpose, and inner fire. Contribute your expertise, insights, and passion to fullfill's growing community.</p>

      <div class="contribution-types">
        <div class="contribution-card">
          <h3>Content Creator</h3>
          <p>Create and share journaling prompts, breathing exercises, meditation guides, or wellness content. Help others on their journey of self-discovery.</p>
          <a href="#contact" class="learn-more">Learn More →</a>
        </div>

        <div class="contribution-card">
          <h3>Expert Advisor</h3>
          <p>Share your professional expertise in psychology, wellness, coaching, or personal development. Consult on platform features and content strategy.</p>
          <a href="#contact" class="learn-more">Learn More →</a>
        </div>

        <div class="contribution-card">
          <h3>Community Builder</h3>
          <p>Help moderate discussions, support community members, and foster a culture of growth and mutual support within fullfill.</p>
          <a href="#contact" class="learn-more">Learn More →</a>
        </div>

        <div class="contribution-card">
          <h3>Developer/Designer</h3>
          <p>Contribute to open-source initiatives, propose new features, or help improve the user experience of the platform.</p>
          <a href="#contact" class="learn-more">Learn More →</a>
        </div>

        <div class="contribution-card">
          <h3>Researcher</h3>
          <p>Collaborate on studies, insights, and research related to wellness, mental health, and personal development.</p>
          <a href="#contact" class="learn-more">Learn More →</a>
        </div>

        <div class="contribution-card">
          <h3>Ambassador</h3>
          <p>Spread the word about fullfill in your network. Share your personal story and help others discover the platform.</p>
          <a href="#contact" class="learn-more">Learn More →</a>
        </div>
      </div>

      <div class="benefits-section">
        <h2>Why Contribute?</h2>
        
        <div class="benefits-list">
          <div class="benefit">
            <h4>Make an Impact</h4>
            <p>Help thousands of people discover clarity and purpose. Your contributions directly improve lives.</p>
          </div>

          <div class="benefit">
            <h4>Grow Your Network</h4>
            <p>Connect with like-minded individuals passionate about wellness and personal growth.</p>
          </div>

          <div class="benefit">
            <h4>Recognition & Rewards</h4>
            <p>Gain visibility, recognition, and exclusive benefits within the fullfill community.</p>
          </div>

          <div class="benefit">
            <h4>Learn & Develop</h4>
            <p>Enhance your skills, knowledge, and experience while collaborating with experts in the field.</p>
          </div>
        </div>
      </div>

      <div class="cta-section">
        <h2>Ready to Make a Difference?</h2>
        <p>We'd love to hear from you. Tell us how you'd like to contribute to fullfill's mission.</p>
        <a href="/contact" class="cta-button">Become a Contributor</a>
      </div>

      <div id="contact" class="contributor-form">
        <h2>Contributor Application</h2>
        <p>Fill out the form below to start your journey as a fullfill contributor.</p>
        
        <form>
          <div class="form-group">
            <label for="name">Full Name</label>
            <input type="text" id="name" name="name" required>
          </div>

          <div class="form-group">
            <label for="email">Email Address</label>
            <input type="email" id="email" name="email" required>
          </div>

          <div class="form-group">
            <label for="expertise">Area of Expertise</label>
            <select id="expertise" name="expertise" required>
              <option value="">Select...</option>
              <option value="content">Content Creation</option>
              <option value="expert">Expert Advisor</option>
              <option value="community">Community Building</option>
              <option value="technical">Development/Design</option>
              <option value="research">Research</option>
              <option value="ambassador">Ambassador</option>
            </select>
          </div>

          <div class="form-group">
            <label for="message">Tell us about your contribution idea</label>
            <textarea id="message" name="message" rows="5" required></textarea>
          </div>

          <button type="submit" class="submit-button">Submit Application</button>
        </form>
      </div>
    </div>
  </section>
</Layout>

<style>
  .contribute-section {
    max-width: 1200px;
    margin: 0 auto;
    padding: 60px 20px;
  }

  .container {
    width: 100%;
  }

  h1 {
    font-size: 2.5rem;
    margin-bottom: 20px;
    color: var(--primary-color, #3f5ef0);
  }

  .intro-text {
    font-size: 1.1rem;
    line-height: 1.8;
    margin-bottom: 50px;
    color: var(--text-secondary, #666);
  }

  .contribution-types {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 30px;
    margin-bottom: 60px;
  }

  .contribution-card {
    padding: 30px;
    border: 2px solid var(--primary-color, #3f5ef0);
    border-radius: 8px;
    background: white;
    transition: all 0.3s ease;
  }

  .contribution-card:hover {
    box-shadow: 0 6px 20px rgba(63, 94, 240, 0.15);
    transform: translateY(-4px);
  }

  .contribution-card h3 {
    font-size: 1.3rem;
    margin-bottom: 15px;
    color: var(--primary-color, #3f5ef0);
  }

  .contribution-card p {
    font-size: 1rem;
    line-height: 1.6;
    margin-bottom: 15px;
    color: var(--text-color, #333);
  }

  .learn-more {
    display: inline-block;
    color: var(--primary-color, #3f5ef0);
    text-decoration: none;
    font-weight: 600;
    transition: all 0.3s ease;
  }

  .learn-more:hover {
    transform: translateX(4px);
  }

  .benefits-section {
    background: var(--card-bg, #fafafa);
    padding: 50px 40px;
    border-radius: 12px;
    margin-bottom: 60px;
  }

  .benefits-section h2 {
    font-size: 1.8rem;
    margin-bottom: 30px;
    color: var(--primary-color, #3f5ef0);
  }

  .benefits-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 30px;
  }

  .benefit h4 {
    font-size: 1.1rem;
    margin-bottom: 10px;
    color: var(--primary-color, #3f5ef0);
  }

  .benefit p {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--text-color, #333);
  }

  .cta-section {
    text-align: center;
    background: linear-gradient(135deg, #99afff, #9a94ff);
    padding: 60px 40px;
    border-radius: 12px;
    color: white;
    margin: 60px 0;
  }

  .cta-section h2 {
    font-size: 2rem;
    margin-bottom: 15px;
  }

  .cta-section p {
    font-size: 1.1rem;
    margin-bottom: 30px;
    opacity: 0.95;
  }

  .cta-button {
    display: inline-block;
    padding: 14px 40px;
    background: white;
    color: var(--primary-color, #3f5ef0);
    text-decoration: none;
    border-radius: 6px;
    font-weight: 600;
    transition: all 0.3s ease;
  }

  .cta-button:hover {
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
    transform: translateY(-2px);
  }

  .contributor-form {
    background: var(--card-bg, #fafafa);
    padding: 50px 40px;
    border-radius: 12px;
    margin-top: 60px;
  }

  .contributor-form h2 {
    font-size: 1.8rem;
    margin-bottom: 10px;
    color: var(--primary-color, #3f5ef0);
  }

  .contributor-form > p {
    margin-bottom: 30px;
    color: var(--text-secondary, #666);
  }

  .form-group {
    margin-bottom: 25px;
  }

  .form-group label {
    display: block;
    margin-bottom: 8px;
    font-weight: 600;
    color: var(--primary-color, #3f5ef0);
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    width: 100%;
    padding: 12px;
    border: 1px solid var(--border-color, #ddd);
    border-radius: 6px;
    font-size: 1rem;
    font-family: inherit;
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--primary-color, #3f5ef0);
    box-shadow: 0 0 0 3px rgba(63, 94, 240, 0.1);
  }

  .submit-button {
    padding: 14px 40px;
    background: var(--primary-color, #3f5ef0);
    color: white;
    border: none;
    border-radius: 6px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    font-size: 1rem;
  }

  .submit-button:hover {
    box-shadow: 0 4px 15px rgba(63, 94, 240, 0.3);
    transform: translateY(-2px);
  }

  @media (max-width: 768px) {
    .contribute-section {
      padding: 40px 15px;
    }

    h1 {
      font-size: 1.8rem;
    }

    .contribution-types {
      grid-template-columns: 1fr;
    }

    .benefits-section {
      padding: 30px 20px;
    }

    .contributor-form {
      padding: 30px 20px;
    }
  }
</style>