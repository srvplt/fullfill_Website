---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/HeroSection.astro';
import ExerciseBanner from '../components/ExerciseBanner.astro';
import BrainCortex from '../components/BrainCortex.astro';
import HaveEverything from '../components/HaveEverything.astro';
import HappinessCompounds from '../components/HappinessCompounds.astro';
import PremiumContent from '../components/PremiumContent.astro';
import FunSection from '../components/FunSection.astro';
import AiSection from '../components/AiSection.astro';
import Podcasts from '../components/Podcasts.astro';
import GetHooked from '../components/GetHooked.astro';
import NeverAlone from '../components/NeverAlone.astro';
import LaunchSpecial from '../components/LaunchSpecial.astro';
import PeaceOfMind from '../components/PeaceOfMind.astro';
---

<Layout
  title="Fullfill – Your Personal Trainer for a Happier Mind"
  ogTitle="Fullfill: Stop Scrolling. Start Growing"
  ogImage="https://raw.githubusercontent.com/srvplt/fullfill_Website/main/src/assets/images/personal%20trainer%201.91x1.jpg"
>
  <HeroSection />
  <ExerciseBanner />
  <BrainCortex />
  <HaveEverything />
  <HappinessCompounds />
  <PremiumContent />
  <FunSection />
  <AiSection />
  <Podcasts />
  <GetHooked />
  <NeverAlone />
  <LaunchSpecial />
  <PeaceOfMind />
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { 
      threshold: 0,
      rootMargin: '0px 0px -100px 0px'
    });

    const targetElements = document.querySelectorAll(
      '.brain-cortex__grid, .brain-cortex__title, .happiness__inner, .premium__title'
    );
    
    targetElements.forEach(el => {
      observer.observe(el);
      // Check if element is already in viewport
      const rect = el.getBoundingClientRect();
      if (rect.top < window.innerHeight && rect.bottom > 0) {
        el.classList.add('is-visible');
        observer.unobserve(el);
      }
    });
  });
</script>
