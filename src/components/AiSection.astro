---
import '../styles/ai-section.css';
---

<section class="ai-section" id="fullfill-ai">
  <div class="ai-section__inner">
    <div class="landing-container ai-section__layout">
      <div class="ai-section__content">
        <h2 class="ai-section__title">fullfillAI:<br />a coach not a chatbot</h2>
        <p class="ai-section__desc">trained on psychology and the journeys of top performers —<br />invaluable insights improve your life</p>
        <a href="#" class="btn-primary btn-coral">download for free</a>
      </div>
      <div class="ai-section__image">
        <div class="ai-section__books">
          <div class="book-stack">
            <img src="/images/bookscool-1.png" alt="Stack of books" class="book-stack__img" />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
