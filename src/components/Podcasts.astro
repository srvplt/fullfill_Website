---
import '../styles/podcasts.css';
---

<section class="podcasts" id="curated-podcasts">
  <div class="landing-container">
    <h2 class="podcasts__title">curated podcasts <em>for you</em></h2>
    <p class="podcasts__subtitle">hand-picked for the inner work that advances your personal growth</p>
    <div class="podcasts__carousel">
      <div class="podcast-card card1">
        <p class="podcast-card__desc">MINDSET</p>
        <p class="podcast-card__title">Rewire how <br/> you think</p>
        <div class="ll-wv">
          <div class="ll-b" style="height:14px;animation-delay:.1s"></div>
          <div class="ll-b" style="height:22px;animation-delay:.25s"></div>
          <div class="ll-b" style="height:28px;animation-delay:.4s"></div>
          <div class="ll-b" style="height:18px;animation-delay:.55s"></div>
          <div class="ll-b" style="height:24px;animation-delay:.7s"></div>
          <div class="ll-b" style="height:12px;animation-delay:.85s"></div>
          <div class="ll-b" style="height:20px;animation-delay:1s"></div>
        </div>
      </div>
      <div class="podcast-card card2">
        <p class="podcast-card__desc">MINDSET</p>
        <p class="podcast-card__title">Deep work, <br/> No noise,</p>
        <div class="ll-wv">
          <div class="ll-b" style="height:14px;animation-delay:.1s"></div>
          <div class="ll-b" style="height:22px;animation-delay:.25s"></div>
          <div class="ll-b" style="height:28px;animation-delay:.4s"></div>
          <div class="ll-b" style="height:18px;animation-delay:.55s"></div>
          <div class="ll-b" style="height:24px;animation-delay:.7s"></div>
          <div class="ll-b" style="height:12px;animation-delay:.85s"></div>
          <div class="ll-b" style="height:20px;animation-delay:1s"></div>
        </div>
      </div>
      <div class="podcast-card card3">
        <p class="podcast-card__desc">MINDSET</p>
        <p class="podcast-card__title">Live with <br/> intention</p>
        <div class="ll-wv">
          <div class="ll-b" style="height:14px;animation-delay:.1s"></div>
          <div class="ll-b" style="height:22px;animation-delay:.25s"></div>
          <div class="ll-b" style="height:28px;animation-delay:.4s"></div>
          <div class="ll-b" style="height:18px;animation-delay:.55s"></div>
          <div class="ll-b" style="height:24px;animation-delay:.7s"></div>
          <div class="ll-b" style="height:12px;animation-delay:.85s"></div>
          <div class="ll-b" style="height:20px;animation-delay:1s"></div>
        </div>
      </div>
    </div>
    <div class="podcasts__tags">
      <a href="#" class="podcasts__tag">Mindset</a>
      <a href="#" class="podcasts__tag">Focus</a>
      <a href="#" class="podcasts__tag">Health</a>
      <a href="#" class="podcasts__tag">Purpose</a>
      <a href="#" class="podcasts__tag">Sleep</a>
      <a href="#" class="podcasts__tag">Relationships</a>
    </div>
  </div>
</section>
