---
import "../styles/header.css";
import { Image } from "astro:assets";
import logo from "../assets/images/FinalLogoNameOnly.png";

const navLinks = [
  { href: "/", label: "home" },
  { href: "/contribute", label: "be a contributor" },
  { href: "/corporate", label: "corporate memberships" },
  { href: "/blog", label: "blog" },
  { href: "/contact", label: "contact us" },
];
---

<header class="site-header" id="header">
  <div class="site-header__inner">
    <a href="/" class="site-header__logo" title="Home">
      <Image src={logo} alt="Fullfill" width={208} height={76} />
    </a>

    <nav class="site-header__nav" aria-label="Main navigation">
      <button
        type="button"
        class="site-header__menu-toggle"
        id="menu-toggle-btn"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="site-header__hamburger-bar bar-top"></span>
        <span class="site-header__hamburger-bar bar-middle"></span>
        <span class="site-header__hamburger-bar bar-bottom"></span>
      </button>

      <ul class="site-header__links" role="menubar">
        {
          navLinks.map((link) => (
            <li role="none">
              <a role="menuitem" href={link.href}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="site-header__mobile-panel" id="mobile-menu" hidden>
        <ul class="site-header__mobile-links" role="menubar">
          {
            navLinks.map((link) => (
              <li role="none">
                <a role="menuitem" href={link.href}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
        <div class="site-header__overlay" id="mobile-overlay"></div>
      </div>
    </nav>
  </div>
</header>

<script is:inline>
  (function () {
    function initHeaderNav() {
      const toggle = document.getElementById("menu-toggle-btn");
      const panel = document.getElementById("mobile-menu");
      const overlay = document.getElementById("mobile-overlay");
      const mobileLinks = document.querySelectorAll(".site-header__mobile-links a");
      if (!toggle || !panel) return;

      function openMenu() {
        panel.removeAttribute("hidden");
        panel.classList.add("is-open");
        document.body.classList.add("menu-open");
        toggle.setAttribute("aria-expanded", "true");
        toggle.classList.add("is-active");
        document.body.style.overflow = "hidden";
      }

      function closeMenu() {
        panel.setAttribute("hidden", "");
        panel.classList.remove("is-open");
        document.body.classList.remove("menu-open");
        toggle.setAttribute("aria-expanded", "false");
        toggle.classList.remove("is-active");
        document.body.style.overflow = "";
      }

      function toggleMenu(e) {
        const isOpen = toggle.getAttribute("aria-expanded") === "true";
        if (isOpen) {
          closeMenu();
        } else {
          openMenu();
        }
      }

      toggle.addEventListener("click", toggleMenu);

      if (overlay) {
        overlay.addEventListener("click", closeMenu);
      }

      mobileLinks.forEach(function (link) {
        link.addEventListener("click", closeMenu);
      });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initHeaderNav);
    } else {
      initHeaderNav();
    }
  })();
</script>