---
import '../styles/premium.css';
---

<section class="premium" id="premium-content">
  <div class="landing-container">
    <h2 class="premium__title">premium content at warehouse prices</h2>
    <div class="premium__grid">
      <div class="stat-card">
        <div class="stat-card__icon">
          <svg viewBox="0 0 24 24"><path d="M12 2a7 7 0 0 0-7 7c0 5 7 13 7 13s7-8 7-13a7 7 0 0 0-7-7z"/><circle cx="12" cy="9" r="2.5"/></svg>
        </div>
        <p class="stat-card__number">480+</p>
        <p class="stat-card__label">minutes<br />of meditation</p>
      </div>
      <div class="stat-card">
        <div class="stat-card__icon">
          <svg viewBox="0 0 24 24"><circle cx="12" cy="4" r="2"/><path d="M12 6v6m-4 4h8M8 16l4-4 4 4M6 20h12"/></svg>
        </div>
        <p class="stat-card__number">50+</p>
        <p class="stat-card__label">yoga sessions<br />&amp; exercises</p>
      </div>
      <div class="stat-card">
        <div class="stat-card__icon">
          <svg viewBox="0 0 24 24"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="23"/><line x1="8" y1="23" x2="16" y2="23"/></svg>
        </div>
        <p class="stat-card__number">12+</p>
        <p class="stat-card__label">hours<br />of podcasts</p>
      </div>
      <div class="stat-card">
        <div class="stat-card__icon">
          <svg viewBox="0 0 24 24"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
        </div>
        <p class="stat-card__number">70+</p>
        <p class="stat-card__label">book<br />summaries</p>
      </div>
    </div>
  </div>
</section>
