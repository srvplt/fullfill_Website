---
import '../styles/premium.css';
import { Image } from 'astro:assets';
import icon1 from '../assets/images/384156-38d6efb7.png';
import icon2 from '../assets/images/4646087-db5d359d.png';
import icon3 from '../assets/images/6165252-9b7ce705.png';
import icon4 from '../assets/images/2702134-693652d6.png';
---

<section class="premium" id="premium-content">
  <div class="landing-container premium__inner">
    <h2 class="premium__title pc-title-animate">premium content at warehouse prices</h2>
    <div class="premium__grid" id="premium-grid">
      <div class="stat-card pc-animate">
        <div class="stat-card__icon">
          <Image src={icon1} alt="meditation" width={64} height={64} />
        </div>
        <p class="stat-card__number">480+</p>
        <p class="stat-card__label">minutes<br />of meditation</p>
      </div>
      <div class="stat-card pc-animate">
        <div class="stat-card__icon">
          <Image src={icon2} alt="yoga" width={64} height={64} />
        </div>
        <p class="stat-card__number">50+</p>
        <p class="stat-card__label">yoga sessions<br />&amp; exercises</p>
      </div>
      <div class="stat-card pc-animate">
        <div class="stat-card__icon">
          <Image src={icon3} alt="podcasts" width={64} height={64} />
        </div>
        <p class="stat-card__number">12+</p>
        <p class="stat-card__label">hours<br />of podcasts</p>
      </div>
      <div class="stat-card pc-animate">
        <div class="stat-card__icon">
          <Image src={icon4} alt="book summaries" width={64} height={64} />
        </div>
        <p class="stat-card__number">70+</p>
        <p class="stat-card__label">book<br />summaries</p>
      </div>
    </div>
  </div>
</section>

<style>
  .pc-animate {
    opacity: 0;
    transform: translateY(300px);
    transition: opacity 0.8s ease 0.2s, transform 0.8s ease 0.2s;
  }
  .pc-title-animate {
    opacity: 0;
    transform: translateX(300px);
    transition: opacity 0.8s ease, transform 0.8s ease;
  }
  .pc-in .pc-animate,
  .pc-in .pc-title-animate {
    opacity: 1;
    transform: translate(0, 0);
  }
</style>

<script>
  const section = document.querySelector('#premium-content');
  const inner = document.querySelector('.premium__inner');

  if (section && inner) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            inner.classList.add('pc-in');
          } else {
            const els = inner.querySelectorAll('.pc-animate, .pc-title-animate');
            els.forEach(el => (el.style.transition = 'none'));
            inner.classList.remove('pc-in');
            requestAnimationFrame(() =>
              requestAnimationFrame(() =>
                els.forEach(el => (el.style.transition = ''))
              )
            );
          }
        });
      },
      { threshold: 0.3 }
    );
    observer.observe(section);
  }
</script>