---
import '../styles/never-alone.css';
---

<section class="never-alone" id="never-alone">
  <div class="landing-container">
    <h2 class="never-alone__title">you're never alone</h2>
    <div class="never-alone__cards">
      <div class="support-card">
        <div class="support-card__icon">
          <svg viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        </div>
        <p class="support-card__name">fullfillment friend</p>
        <p class="support-card__desc">a personalised AI assistant curated to aid in your personal growth journey</p>
      </div>
      <div class="support-card">
        <div class="support-card__icon">
          <svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
        <p class="support-card__name">certified psychiatrist</p>
        <p class="support-card__desc">book a session with a certified professional for a deep dive into your well-being</p>
      </div>
    </div>
  </div>
</section>
