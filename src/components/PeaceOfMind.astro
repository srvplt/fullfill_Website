---
import '../styles/peace-of-mind.css';
---

<section class="peace-of-mind" id="peace-of-mind">
  <div class="peace-phones-wrap">
    <div class="peace-phones-circle"></div>
    <img src="/images/042sidebyside.png" alt="Peace of mind tracker" class="peace-phones-img" />
  </div>
  <div class="landing-container peace-of-mind__inner">
    <div class="peace-of-mind__content">
      <h2 class="peace-of-mind__title">peace of mind,<br /><span>tracked.</span></h2>
      <p class="peace-of-mind__desc">never miss a pill. stay consistent with smart reminders.</p>
      <div class="peace-progress">
        <span class="peace-progress__label">DAILY ADHERENCE</span>
        <div class="peace-progress__bar">
          <div class="peace-progress__fill"></div>
        </div>
        <span class="peace-progress__value">92%</span>
      </div>
      <div class="peace-of-mind__tags">
        <a href="#" class="peace-tag">smart reminders</a>
        <a href="#" class="peace-tag">streak tracking</a>
        <a href="#" class="peace-tag">⟳ wearables soon</a>
      </div>
    </div>
    <div class="peace-of-mind__phone">
      <div class="peace-card">
        <p class="peace-card__week-label">THIS WEEK</p>
        <div class="peace-card__days">
          <span>M</span><span>T</span><span>W</span><span>T</span><span>F</span><span>S</span><span>S</span>
        </div>
        <div class="peace-card__dots-row">
          <div class="peace-dot peace-dot--filled"></div>
          <div class="peace-dot peace-dot--filled"></div>
          <div class="peace-dot peace-dot--filled"></div>
          <div class="peace-dot peace-dot--filled"></div>
          <div class="peace-dot peace-dot--filled"></div>
          <div class="peace-dot peace-dot--filled"></div>
          <div class="peace-dot peace-dot--filled"></div>
        </div>
        <div class="peace-card__dots-row">
          <div class="peace-dot peace-dot--filled"></div>
          <div class="peace-dot peace-dot--filled"></div>
          <div class="peace-dot peace-dot--filled"></div>
          <div class="peace-dot peace-dot--filled"></div>
          <div class="peace-dot peace-dot--filled"></div>
          <div class="peace-dot peace-dot--filled"></div>
          <div class="peace-dot peace-dot--empty"></div>
        </div>
        <div class="peace-card__reminder">
          <div>
            <p class="peace-card__reminder-label">NEXT REMINDER</p>
            <p class="peace-card__reminder-time">8:00 pm</p>
          </div>
          <span class="peace-card__bell">🔔</span>
        </div>
      </div>
    </div>
  </div>
</section>
