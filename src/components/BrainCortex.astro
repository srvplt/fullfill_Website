---
import '../styles/brain-cortex.css';
import icon1 from '../assets/images/brainCortexIcon1.png';
import icon2 from '../assets/images/brainCortexIcon2.png';
import icon3 from '../assets/images/brainCortexIcon3.png';
import icon4 from '../assets/images/brainCortexIcon4.png';
---

<section class="brain-cortex" id="brain-cortex">
  <div class="landing-container">
    <h2 class="brain-cortex__title">the only app that trains all 4 cortex of the brain</h2>
    <div class="brain-cortex__grid">
      <div class="cortex-card">
        <div class="cortex-card__icon">
          <img src={icon1.src} alt="calmness icon" />
        </div>
        <div class="cortex-card__body">
          <p class="cortex-card__label">calmness</p>
          <p class="cortex-card__desc">shift your mind from stress to serenity</p>
        </div>
      </div>
      <div class="cortex-card">
        <div class="cortex-card__icon">
          <img src={icon2.src} alt="clarity icon" />
        </div>
        <div class="cortex-card__body">
          <p class="cortex-card__label">clarity</p>
          <p class="cortex-card__desc">uncover meaning and purpose in your life</p>
        </div>
      </div>
      <div class="cortex-card">
        <div class="cortex-card__icon">
          <img src={icon3.src} alt="control icon" />
        </div>
        <div class="cortex-card__body">
          <p class="cortex-card__label">control</p>
          <p class="cortex-card__desc">build sticky habits for a better daily</p>
        </div>
      </div>
      <div class="cortex-card">
        <div class="cortex-card__icon">
          <img src={icon4.src} alt="connect icon" />
        </div>
        <div class="cortex-card__body">
          <p class="cortex-card__label">connect</p>
          <p class="cortex-card__desc">build meaningful relationships</p>
        </div>
      </div>
    </div>
  </div>
</section>
