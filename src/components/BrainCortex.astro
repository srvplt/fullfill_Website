---
import '../styles/brain-cortex.css';
---

<section class="brain-cortex" id="brain-cortex">
  <div class="landing-container">
    <h2 class="brain-cortex__title">the only app that trains all 4 cortex of the brain</h2>
    <div class="brain-cortex__grid">
      <div class="cortex-card">
        <div class="cortex-card__icon">
          <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><circle cx="9" cy="10" r="1"/><circle cx="15" cy="10" r="1"/></svg>
        </div>
        <div class="cortex-card__body">
          <p class="cortex-card__label">calmness</p>
          <p class="cortex-card__desc">shift your mind from stress to serenity</p>
        </div>
      </div>
      <div class="cortex-card">
        <div class="cortex-card__icon">
          <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M12 5v-.5M12 19.5V19M5 12h-.5M19.5 12H19M7.05 7.05l-.35-.35M17.3 17.3l-.35-.35M7.05 16.95l-.35.35M17.3 6.7l-.35.35"/></svg>
        </div>
        <div class="cortex-card__body">
          <p class="cortex-card__label">clarity</p>
          <p class="cortex-card__desc">uncover meaning and purpose in your life</p>
        </div>
      </div>
      <div class="cortex-card">
        <div class="cortex-card__icon">
          <svg viewBox="0 0 24 24"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/><path d="M12 8v4l3 3"/></svg>
        </div>
        <div class="cortex-card__body">
          <p class="cortex-card__label">control</p>
          <p class="cortex-card__desc">build sticky habits for a better daily</p>
        </div>
      </div>
      <div class="cortex-card">
        <div class="cortex-card__icon">
          <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
        <div class="cortex-card__body">
          <p class="cortex-card__label">connect</p>
          <p class="cortex-card__desc">build meaningful relationships</p>
        </div>
      </div>
    </div>
  </div>
</section>
