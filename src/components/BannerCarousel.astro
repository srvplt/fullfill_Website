---
import '../styles/banner-carousel.css';
---

<section class="banner-carousel" id="banner-carousel">
  <img id="banner-bg" src="/assets/images/banner/nature-3046567_1280.jpg" alt="Banner image" class="banner-carousel__bg" width="1400" height="500" />
  <div class="banner-carousel__overlay"></div>
  <div class="banner-carousel__content">
    <h2 class="banner-carousel__title">Welcome to Fullfill</h2>
    <p class="banner-carousel__subtitle">Your personal trainer for a happier mind</p>
  </div>
  <script is:inline>
    const slides = [
      {image: '/assets/images/banner/nature-3046567_1280.jpg', title: 'Welcome to Fullfill', subtitle: 'Your personal trainer for a happier mind'},
      {image: '/assets/images/banner/unsplash-1545389336.jpg', title: 'Mindful Movement', subtitle: 'Exercise for body & mind'},
      {image: '/assets/images/banner/unsplash-1419242902214.jpg', title: 'Balanced Life', subtitle: 'Find your equilibrium'},
      {image: '/assets/images/banner/unsplash-1544367567.jpg', title: 'Healthy Habits', subtitle: 'Build routines that stick'},
      {image: '/assets/images/banner/unsplash-1455390582262.jpg', title: 'Nutrition & Wellness', subtitle: 'Feed your body right'},
      {image: '/assets/images/banner/spring-salad-recipes-1024x636.jpg', title: 'Fresh Flavors', subtitle: 'Enjoy vibrant meals'},
      {image: '/assets/images/banner/unsplash-1518611012118.jpg', title: 'Active Outdoors', subtitle: 'Stay moving outside'},
      {image: '/assets/images/banner/unsplash-1506905925346.jpg', title: 'Daily Energy', subtitle: 'Boost your vitality'},
      {image: '/assets/images/banner/unsplash-1484480974693.jpg', title: 'Mindful Rest', subtitle: 'Recharge your mind'},
      {image: '/assets/images/banner/unsplash-1481627834876.jpg', title: 'Growth Journey', subtitle: 'Progress every day'}
    ];
    let current = 0;
    const img = document.getElementById('banner-bg');
    const titleEl = document.querySelector('.banner-carousel__title');
    const subtitleEl = document.querySelector('.banner-carousel__subtitle');
    function showNext(){
      current = (current + 1) % slides.length;
      const slide = slides[current];
      img.style.opacity = '0';
      setTimeout(()=>{
        img.src = slide.image;
        titleEl.textContent = slide.title;
        subtitleEl.textContent = slide.subtitle;
        img.style.opacity = '1';
      },800);
    }
    setInterval(showNext, 5000);
  </script>
</section>
